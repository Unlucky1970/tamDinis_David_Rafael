# Ligacao ao PostgreSQL (Neon / Vercel Postgres / Supabase...)
DATABASE_URL=postgresql://utilizador:password@host/base?sslmode=require

# Segredo para assinar os tokens JWT da app (texto longo e aleatorio)
JWT_SECRET=troca-isto-por-um-segredo-longo-e-aleatorio

# Fuso horario usado nas permissoes de acesso
FUSO_HORARIO=Europe/Lisbon

# A chave do Arduino ja nao fica aqui: e guardada (em SHA-256) na tabela dispositivos
